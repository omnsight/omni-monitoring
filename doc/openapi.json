            "description": "The language that workflow generates data in by the trigger"
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "ID of user who created the trigger"
          }
        },
        "type": "object",
        "required": [
          "language",
          "user_id"
        ],
        "title": "MonitorTrigger",
        "description": "Model for monitor trigger."
